{
  "name": "awaken-signal-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4317 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:update-goldens": "UPDATE_GOLDENS=1 playwright test visual",
    "validate:glsl": "vitest run tests/unit/glsl.test.ts",
    "ci": "npm run typecheck && npm run test && npm run validate:glsl && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
